{
  "name": "optimistic-carson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.js",
    "test:security": "node --test tests/heisenbyte-full-security-and-vulnerability-matrix.test.js tests/heisenbyte-deep-mobile-and-mainsite.test.js",
    "test:mobile": "node --test tests/mobile-app.test.js tests/heisenbyte-deep-mobile-and-mainsite.test.js",
    "test:sync": "node --test tests/cross-module-integrity.test.js",
    "audit:sync": "npx tsx scripts/audit-cross-module-sync.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "verify": "prisma validate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
