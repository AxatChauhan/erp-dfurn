generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String   // In a real app, hash this!
  role      String   @default("SALES") // SUPER_ADMIN, SALES, MANAGER, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id              String      @id @default(uuid())
  clientType      String      @default("BUSINESS") // INDIVIDUAL, BUSINESS
  name            String      // Individual Name or Company Name
  contactPerson   String?     // Contact person if BUSINESS
  
  emails          Json?       // Array of email strings
  phones          Json?       // Array of phone strings
  addresses       Json?       // Array of address objects: { label, street, city, state, zip }
  
  sourceCategory  String?     // e.g., 'DIRECT', 'SOCIAL_MEDIA', 'WEBSITE', 'REFERRAL'
  sourceName      String?     // e.g., name of referrer
  
  taxId           String?     // GSTIN
  paymentTerms    String?
  creditLimit     Float?      @default(0.00)
  isActive        Boolean     @default(true)
  
  enquiries       Enquiry[]
  quotations      Quotation[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Enquiry {
  id               String        @id @default(uuid())
  enquiryNumber    String        @unique 
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  
  status           String        @default("NEW") // NEW, IN_PROGRESS, QUALIFIED, DROPPED, CONVERTED
  
  // Discovery & Context
  expectedTimeline String?       // e.g., 'Urgent', '1-3 Months', 'Flexible'
  estimatedBudget  Float?        
  propertyType     String?       // e.g., 'Residential', 'Commercial Office'
  
  // Follow-ups & Notes
  nextFollowUp     DateTime?
  notes            String?       // Keep as a simple string for general notes or a single block of text
  
  // New Additions
  sourceCategory   String?
  sourceName       String?
  attachments      Json?         // Array of { name, url }
  
  items            EnquiryItem[]
  quotations       Quotation[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model EnquiryItem {
  id                 String   @id @default(uuid())
  enquiryId          String
  enquiry            Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  description        String
  quantity           Int      @default(1)
  unitPrice          Float    @default(0.00)
  total              Float    @default(0.00)
  
  expectedDimensions String?  // e.g., "1200x600x750mm"
  materialPreference String?  // e.g., "Teak Wood", "MDF"
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique 
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  enquiryId       String?
  enquiry         Enquiry?        @relation(fields: [enquiryId], references: [id])
  status          String          @default("DRAFT")
  totalAmount     Float           @default(0.00)
  items           QuotationItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0.00)
  total       Float     @default(0.00)
}
